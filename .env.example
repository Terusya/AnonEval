# PostgreSQL superuser password used only during local container initialization.
POSTGRES_PASSWORD=
# Application role password; the API and seed job use this restricted account.
APP_DB_PASSWORD=
# Dedicated broker account password, used by the API publisher and worker.
RABBITMQ_PASSWORD=
# Database name created by the PostgreSQL image.
POSTGRES_DB=anonymous_survey
# 32-byte-or-longer secret pepper used with Argon2id password hashing.
PEPPER_SECRET=
# Shared internal-only secret used to authenticate trusted service headers.
APP_INTERNAL_SECRET=
# Passwords for the three local demo users, hashed by the seed job.
DEMO_STUDENT1_PASSWORD=
DEMO_STUDENT2_PASSWORD=
DEMO_STAFF_PASSWORD=
# Public host ports.
WEB_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Set true only when serving the app behind HTTPS.
COOKIE_SECURE=false
# Redis session lifetime in seconds (8 hours by default).
SESSION_TTL_SECONDS=28800
# One-time password reset token lifetime in seconds (15 minutes by default).
RESET_TTL_SECONDS=900
